# REST API base URL (FastAPI)
REACT_APP_API_BASE=https://your-backend.example.com

# WebSocket signaling endpoint for WebRTC signaling
REACT_APP_WS_URL=ws://your-backend.example.com/ws

# Optional: convenience values used by some flows/logs
REACT_APP_BACKEND_URL=https://your-backend.example.com
REACT_APP_FRONTEND_URL=https://your-frontend.example.com
